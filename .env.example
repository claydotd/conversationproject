# Required for the /admin portal.
# ADMIN_SESSION_SECRET should be a long random string used only for signing cookies.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Netlify Database is provisioned automatically on deploy / netlify dev.
# You do not need to set a connection string yourself.

# Eventbrite events listing at /events
# Private token from Eventbrite → Account Settings → Developer Links → API Keys
EVENTBRITE_API_KEY=
# Organizer id (production: 114391829571; local test: 11387277847)
EVENTBRITE_ORGANIZER_ID=114391829571

# SumUp online shop at /shop
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Optional; include if your SumUp account expects it on checkout create
SUMUP_PAY_TO_EMAIL=

# Receipt emails (Resend). Required for order receipts with the /downloads link.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional absolute site URL used in receipt emails (defaults to request origin)
# PUBLIC_SITE_URL=https://theconversationproject.netlify.app
