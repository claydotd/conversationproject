# Required for the /admin portal.
# Generate a long random string for ADMIN_SESSION_SECRET.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Netlify Database is provisioned automatically on deploy / netlify dev.
# You do not need to set a connection string yourself.

# Eventbrite events listing at /events
# Private token from Eventbrite → Account Settings → Developer Links → API Keys
EVENTBRITE_API_KEY=
# Organizer id from https://www.eventbrite.co.uk/o/the-conversation-project-114391829571
EVENTBRITE_ORGANIZER_ID=114391829571

# Future: SumUp online shop
# SUMUP_API_KEY=
# SUMUP_MERCHANT_CODE=
# SUMUP_PAY_TO_EMAIL=
